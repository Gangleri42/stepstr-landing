{
	"name": "stepstr-landing",
	"private": true,
	"version": "0.0.1",
	"description": "The landing pages for stepstr: a STEP file drawn live by stepstr's own viewer as the page scrolls.",
	"homepage": "https://start.stepstr.space",
	"repository": "github:Gangleri42/stepstr-landing",
	"license": "Unlicense",
	"type": "module",
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite",
		"model": "tsx tools/model.ts",
		"stills": "tsx tools/stills.ts",
		"review": "tsx tools/stills.ts --review",
		"build": "npm run model && npm run stills && vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json --diagnostic-sources js,css && tsc -p tsconfig.node.json",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@gltf-transform/core": "4.5.0",
		"@gltf-transform/extensions": "4.5.0",
		"@noble/hashes": "2.4.0",
		"fflate": "^0.8.3",
		"meshoptimizer": "1.3.0",
		"nostr-tools": "^2.25.2",
		"svelte": "^5.56.1",
		"three": "0.186.1",
		"three-mesh-bvh": "0.9.15"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.6.3",
		"@types/three": "^0.186.0",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.2"
	}
}
